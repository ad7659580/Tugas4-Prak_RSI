# Salin menjadi .env lalu isi nilainya. Jangan commit .env ke GitHub.
PORT=3000
# Alamat frontend yang boleh memanggil API (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:5173

DB_SERVER=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=review_kantin
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Isi dengan string acak panjang, buat dengan:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=10
